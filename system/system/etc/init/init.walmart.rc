on boot
   # Bind mount of a persist partition
   mkdir /mnt/vendor/persist/misc 0775 root system
   mkdir /mnt/persist 0775 system system
   mkdir /mnt/persist/misc 0775 root system
   mount none /mnt/vendor/persist/misc /mnt/persist/misc bind
   restorecon_recursive /mnt/persist/misc

on boot
   chmod 0775 /mnt/vendor/persist/misc/FTM_APP
   chmod 0775 /mnt/vendor/persist/misc/FTM_APP/FTM_report
